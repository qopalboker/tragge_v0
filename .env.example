# =============================================================================
# Tragge Trading Platform - Environment Configuration
# =============================================================================
#
# IMPORTANT: Sensitive values (passwords, API keys, secrets) are managed via
# Docker secrets in development and external secrets managers in production.
#
# See docs/SECURE_KEY_MANAGEMENT.md for full documentation.
#
# Quick setup:
#   1. Copy this file to .env: cp .env.example .env
#   2. Initialize secrets: ./scripts/secrets/init-secrets.sh
#   3. Update API keys in infra/docker/secrets/
#
# =============================================================================
# Database Configuration
# =============================================================================
# Non-sensitive database configuration
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use "disable" only for local development without TLS
# Use "require" or "verify-full" in production (enforced by startup check)
POSTGRES_SSLMODE=prefer

# Database High-Concurrency Settings (for 1000+ concurrent users)
# Set to "true" to use optimized pool settings (max_open=100, max_idle=25, lifetime=3min)
# Ensure PostgreSQL max_connections is set appropriately (recommended: 200+)
# DB_HIGH_CONCURRENCY=true
# DB_MAX_OPEN_CONNS=100
# DB_MAX_IDLE_CONNS=25
# DB_CONN_MAX_LIFETIME_SECONDS=180
# DB_CONN_MAX_IDLE_TIME_SECONDS=30
# DB_MAX_REPLICATION_LAG_SECONDS=10

# Per-Service Connection Pool Settings (override per pod)
# These are read by each service via DB_MAX_OPEN_CONNS / DB_MAX_IDLE_CONNS env vars.
# Recommended values for 1000 concurrent users with PgBouncer (transaction mode):
#
#   Service              Replicas    MaxOpen  MaxIdle  Total (worst-case)
#   -------------------------------------------------------------------
#   Trading Engine       4 (SS)       25       10      100
#   Trade-BFF            2-10 (HPA)   15        5      150
#   Leaderboard Worker   1-5  (HPA)   15        5       75
#   User-BFF             2-4  (HPA)   15        5       60
#   Admin-BFF            1-2  (HPA)   10        5       20
#   -------------------------------------------------------------------
#   Total worst-case                                  ~440 client conns
#
# PgBouncer multiplexes these into ~50-100 real PostgreSQL connections.
# See infra/pgbouncer/pgbouncer.ini.template for PgBouncer tuning.
#
# DB_MAX_OPEN_CONNS=25   # Set per service in K8s configmap
# DB_MAX_IDLE_CONNS=10   # Set per service in K8s configmap

# =============================================================================
# Redis Configuration
# =============================================================================
# Mode: standalone (default), sentinel, or cluster
REDIS_MODE=standalone
REDIS_ADDR=localhost:6379
REDIS_DB=0
# REDIS_PASSWORD is managed via Docker secrets (infra/docker/secrets/redis_password.txt)
# Run ./scripts/secrets/init-secrets.sh to generate.
# For local dev without Docker, set REDIS_PASSWORD directly.
# REDIS_PASSWORD=

# Redis Sentinel (when REDIS_MODE=sentinel)
# REDIS_SENTINEL_ADDRS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
# REDIS_SENTINEL_MASTER=mymaster

# Redis Cluster (when REDIS_MODE=cluster)
# REDIS_CLUSTER_ADDRS=node-1:6379,node-2:6379,node-3:6379,node-4:6379,node-5:6379,node-6:6379

# Redis High-Concurrency Settings (for 1000+ concurrent users)
# Set to "true" to use optimized pool settings (pool_size=100, min_idle=20, health_checks)
# REDIS_HIGH_CONCURRENCY=true
# REDIS_POOL_SIZE=100
# REDIS_MIN_IDLE_CONNS=20
# REDIS_HEALTH_CHECK_FREQ_SECONDS=30
# REDIS_POOL_TIMEOUT_SECONDS=4

# =============================================================================
# Kafka (Redpanda) Configuration
# =============================================================================
KAFKA_BROKERS=localhost:9092

# Kafka Security (optional, for production)
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=                   # Use Docker secrets in production
# KAFKA_TLS_ENABLED=false

# =============================================================================
# Session Management
# =============================================================================
# SESSION_TTL_DAYS: How long sessions remain valid (default: 30 days)
# SESSION_TTL_DAYS=30

# SESSION_MAX_PER_USER: Maximum concurrent sessions per user (default: 10)
# Oldest sessions are automatically deleted when this limit is exceeded
# SESSION_MAX_PER_USER=10

# =============================================================================
# Market Ingestor Configuration
# =============================================================================
# MARKET_PROVIDER: massive|twelvedata|auto (default: massive)
#   - massive: Use only Massive (recommended)
#   - twelvedata: Use only TwelveData
#   - auto: Use Massive as primary, TwelveData as fallback
MARKET_PROVIDER=massive

# Symbols to subscribe to (comma-separated)
# Default: 47 symbols (23 forex incl. metals + 24 crypto)
SYMBOLS=EUR/USD,GBP/USD,USD/JPY,USD/CHF,AUD/USD,NZD/USD,USD/CAD,EUR/GBP,EUR/JPY,GBP/JPY,AUD/JPY,CHF/JPY,EUR/AUD,GBP/AUD,EUR/CAD,AUD/NZD,CAD/JPY,NZD/JPY,EUR/CHF,GBP/CHF,GBP/CAD,XAU/USD,XAG/USD,BTC/USD,ETH/USD,SOL/USD,DOGE/USD,XRP/USD,ADA/USD,AVAX/USD,LINK/USD,DOT/USD,POL/USD,SHIB/USD,LTC/USD,UNI/USD,ETC/USD,XLM/USD,NEAR/USD,AAVE/USD,SUI/USD,PEPE/USD,ARB/USD,OP/USD,APT/USD,INJ/USD,RENDER/USD

# Failover configuration (only applies when MARKET_PROVIDER=auto)
# Time before switching to fallback provider (e.g., 30s, 1m)
FAILOVER_TIMEOUT=30s

# Whether to switch back to primary when it recovers (true/false)
AUTO_SWITCHBACK=true

# Delay before attempting to switch back to primary (e.g., 60s, 2m)
SWITCHBACK_DELAY=60s

# How often to check if primary is healthy (e.g., 30s, 1m)
HEALTH_CHECK_PERIOD=30s

# API key for market-ingestor control endpoints (/control/switch-provider, /control/reconnect)
# REQUIRED: Set a strong random API key. Generate with: openssl rand -hex 32
# If not set, control endpoints will reject all requests.
CONTROL_API_KEY=

# API key for admin-bff to authenticate with market-ingestor proxy endpoints
MARKET_INGESTOR_API_KEY=

# Nobitex Crypto Feed (Primary crypto provider)
# =============================================================================
# Nobitex provides real-time crypto prices via REST API polling.
# When enabled, crypto symbols are sourced from Nobitex (not Massive).
# Massive/TwelveData continue handling forex, commodity, and stock symbols.
#
# NOBITEX_ENABLED: true|false (default: true)
NOBITEX_ENABLED=true
#
# Polling interval for /v3/orderbook/all endpoint
# Rate limit: 300 req/min. Minimum safe interval: 200ms
# Recommended: 2s for production, 5s for development
NOBITEX_POLL_INTERVAL=2s
#
# USDT to USD conversion rate
# Set to 0.999 for conservative pricing, or 1.0 for 1:1
NOBITEX_USDT_USD_RATE=1.0
#
# Base URL (change for testing/staging)
# NOBITEX_BASE_URL=https://apiv2.nobitex.ir

# =============================================================================
# Withdrawal Limits (AML compliance)
# =============================================================================
# System-wide defaults; per-user overrides stored in withdrawal_limits table
# DAILY_WITHDRAW_AMOUNT_CENTS=1000000     # $10,000/day
# MONTHLY_WITHDRAW_AMOUNT_CENTS=5000000   # $50,000/month
# DAILY_WITHDRAW_COUNT=3                  # Max 3 withdrawals/day
# MONTHLY_WITHDRAW_COUNT=10               # Max 10 withdrawals/month

# =============================================================================
# Service Ports (defaults shown)
# =============================================================================
# USER_BFF_PORT=8081
# TRADE_BFF_PORT=8082
# ADMIN_BFF_PORT=8083
# TRADING_ENGINE_PORT=8085
# MARKET_INGESTOR_PORT=8084
# LEADERBOARD_WORKER_PORT=8086

# =============================================================================
# Observability Configuration
# =============================================================================
ENVIRONMENT=development
# VERSION=1.0.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# Frontend Logging Configuration
# =============================================================================
# Log level for frontend (debug, info, warn, error)
# In development: defaults to "info" if not set
# In production: defaults to "error" if not set (only errors are logged)
# VITE_LOG_LEVEL=info

# =============================================================================
# CORS / Allowed Origins (all services)
# =============================================================================
# Comma-separated list of allowed origins for CORS and CSRF checks.
# Used by all BFF and backend services. Default (if unset) is localhost only.
# Uncomment and modify for remote dev or production:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
#
# GitHub Codespaces: origins are auto-detected via CODESPACE_NAME env var.
# No manual configuration needed for Codespaces.
#
# Production example:
# ALLOWED_ORIGINS=https://app.tragge.com,https://trade.tragge.com,https://admin.tragge.com
# User/Admin CSRF origin allowlists are intentionally separate:
# USER_FRONTEND_ORIGIN=https://app.tragge.com
# ADMIN_FRONTEND_ORIGIN=https://admin.tragge.com

# SEC-006 edge policy uses exact context-specific origins. Wildcards are not
# accepted in production. Codespaces must provide their exact generated origin.
USER_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
ADMIN_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081
TRADE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
PAYMENT_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080

# Only these immediate proxy CIDRs may supply X-Forwarded-* identity. The local
# Docker Compose network is pinned to 172.30.0.0/24. Production must set the
# exact ingress proxy ranges and may not rely on private-network defaults.
TRUSTED_PROXY_CIDRS=172.30.0.0/24

# Request-policy bounds. JSON/form requests use the default; approved file
# upload routes opt into the larger limit.
EDGE_MAX_BODY_BYTES=1048576
EDGE_MAX_UPLOAD_BYTES=36700160
EDGE_MAX_HEADER_BYTES=16384

# Signed payment callbacks must also be fresh and replay-resistant.
PAYMENT_WEBHOOK_MAX_AGE=5m

# User/Admin JWT metadata. Production startup requires all four values and
# rejects equal issuers or audiences.
# JWT_ISSUER_USER=tragge-user-auth
# JWT_AUDIENCE_USER=user
# JWT_ISSUER_ADMIN=tragge-admin-auth
# JWT_AUDIENCE_ADMIN=admin

# =============================================================================
# WebSocket Authentication (trade-bff)
# WebSocket Compression (RFC 7692)
# Compression reduces bandwidth by ~60% for typical JSON messages
# WS_COMPRESSION_ENABLED=true
# WS_COMPRESSION_LEVEL=1  # 1=BestSpeed, 9=BestCompression
# WS_COMPRESSION_MIN_SIZE=100  # Minimum message size to compress

# Broadcast Worker Pool
# BROADCAST_WORKERS=16  # Default: 2 * CPU cores

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# Auth endpoints rate limiting (login, register)
# Limits per IP address to prevent brute force attacks
# AUTH_RATE_LIMIT=5
# AUTH_RATE_WINDOW=1m

# Contest join rate limiting
# CONTEST_JOIN_RATE_LIMIT=10
# CONTEST_JOIN_RATE_WINDOW=1m

# =============================================================================
# Notifications Configuration
# =============================================================================
# Security-code email senders. These local-only addresses are not valid
# production defaults; production startup requires configured provider-approved senders.
MAILERINO_FROM_EMAIL=security@local.invalid
MAILERINO_BASE_URL=https://api.mailerino.com
RESEND_FROM_EMAIL=security@local.invalid
RESEND_BASE_URL=https://api.resend.com
# MAILERINO_API_KEY, RESEND_API_KEY, and the independent
# SECURITY_CODE_HASH_SECRET are loaded from secret files.

# Email recipients for critical alerts (comma-separated)
NOTIFICATION_EMAIL_RECIPIENTS=admin@example.com

# Enable/disable notifications (default: false in development)
NOTIFICATION_ENABLED=false

# Use async sending (default: true, recommended for production)
NOTIFICATION_ASYNC=true

# Number of async workers (default: 5)
NOTIFICATION_ASYNC_WORKERS=5

# =============================================================================
# OAuth Configuration (Google Social Login)
# =============================================================================
# Redirect URI for OAuth callbacks (must match Google Cloud Console settings)
# Note: This should point to the frontend callback page, which handles the OAuth
# redirect and exchanges the code via API call to /api/user/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/user/auth/google/callback

# OAuth scopes (default: email profile)
# GOOGLE_OAUTH_SCOPES=email,profile

# =============================================================================
# SMS Configuration (KaveNegar - Iranian SMS gateway)
# =============================================================================
SMS_ENABLED=true
SMS_PROVIDER=kavenegar       # Production rejects mock/fake/logging/no-op modes
SMS_SENDER=                  # Empty = KaveNegar default line
SMS_TEMPLATE=tragge-verify   # Template name registered in KaveNegar panel
# KAVENEGAR_API_KEY loaded from Docker secret

# =============================================================================
# ARCaptcha Configuration (Iranian CAPTCHA service for bot protection)
# =============================================================================
# Get your keys from https://arcaptcha.co
ARCAPTCHA_SITE_KEY=slfe0vo1z6
# ARCAPTCHA_SECRET_KEY is loaded via secrets package (see infra/docker/secrets/)
# Frontend site key (used by Vue app)
VITE_ARCAPTCHA_SITE_KEY=slfe0vo1z6

# =============================================================================
# Jibit Payment Gateway Configuration
# =============================================================================
# Base URL for Jibit payment gateway (defaults to https://napi.jibit.ir/ppg/v3)
# JIBIT_BASE_URL=https://napi.jibit.ir/ppg/v3

# Jibit callback URL — must match the nginx route, NOT the /api/payments prefix.
# nginx routes /callback/jibit directly to the payment service.
# JIBIT_CALLBACK_URL=https://tragge.com/callback/jibit

# REQUIRED for payment result redirect after deposit:
# SUCCESS_REDIRECT_URL=http://localhost:5173/payment/result?status=1
# CANCEL_REDIRECT_URL=http://localhost:5173/payment/result?status=0

# REQUIRED for crypto deposits: External base URL for webhook callbacks from payment providers.
# NOWPayments will POST to {WEBHOOK_BASE_URL}/webhooks/nowpayments
# Must be publicly accessible. Do NOT include trailing slash.
# WEBHOOK_BASE_URL=http://localhost:8091

# =============================================================================
# Jibit KYC Configuration (Identity Verification)
# =============================================================================
# Base URL for Jibit identity/KYC API (defaults to https://napi.jibit.ir)
# JIBIT_KYC_BASE_URL=https://napi.jibit.ir

# =============================================================================
# S3/MinIO Storage Configuration (Avatar Uploads)
# =============================================================================
# S3-compatible object storage for user avatar uploads.
# Uses MinIO in development and AWS S3 in production.
#
# Endpoint (without protocol)
# S3_ENDPOINT=minio:9000          # Docker Compose
# S3_ENDPOINT=s3.amazonaws.com    # AWS S3
S3_ENDPOINT=localhost:9000

# Use SSL (true for AWS S3, false for local MinIO)
S3_USE_SSL=false

# Bucket name for avatar storage
S3_BUCKET=tragge-avatars

# AWS region (required for S3, any value works for MinIO)
S3_REGION=us-east-1

# Public URL prefix for avatar URLs returned to clients
# In production, this would be your CDN URL: https://cdn.tragge.com
# In development, this points to the local MinIO instance
S3_PUBLIC_URL=http://localhost:9000/tragge-avatars

# Bucket name for KYC document storage (private, no public read access)
S3_KYC_BUCKET=tragge-kyc

# =============================================================================
# SENSITIVE VALUES - DO NOT SET HERE
# =============================================================================
# The following values should be managed via Docker secrets (development)
# or external secrets managers (production):
#
# - POSTGRES_PASSWORD  -> infra/docker/secrets/postgres_password.txt
# - REDIS_PASSWORD     -> infra/docker/secrets/redis_password.txt
# - JWT_SECRET_USER          -> infra/docker/secrets/jwt_secret_user.txt
# - JWT_REFRESH_SECRET_USER  -> infra/docker/secrets/jwt_refresh_secret_user.txt
# - JWT_SECRET_ADMIN         -> infra/docker/secrets/jwt_secret_admin.txt
# - JWT_REFRESH_SECRET_ADMIN -> infra/docker/secrets/jwt_refresh_secret_admin.txt
#   These four values must be independently generated and pairwise distinct.
# - TWELVEDATA_API_KEYS-> infra/docker/secrets/twelvedata_api_keys.txt
# - MASSIVE_API_KEYS   -> infra/docker/secrets/massive_api_keys.txt
# - SECURITY_CODE_HASH_SECRET -> infra/docker/secrets/security_code_hash_secret.txt
# - MAILERINO_API_KEY  -> infra/docker/secrets/mailerino_api_key.txt
# - RESEND_API_KEY     -> infra/docker/secrets/resend_api_key.txt
# - KAVENEGAR_API_KEY  -> infra/docker/secrets/kavenegar_api_key.txt
# - DISCORD_WEBHOOK_URL-> infra/docker/secrets/discord_webhook_url.txt
# - GOOGLE_CLIENT_ID   -> infra/docker/secrets/google_client_id.txt
# - GOOGLE_CLIENT_SECRET-> infra/docker/secrets/google_client_secret.txt
# - JIBIT_API_KEY      -> infra/docker/secrets/jibit_api_key.txt
# - JIBIT_SECRET_KEY   -> infra/docker/secrets/jibit_secret_key.txt
# - JIBIT_KYC_API_KEY  -> infra/docker/secrets/jibit_kyc_api_key.txt
# - JIBIT_KYC_SECRET_KEY -> infra/docker/secrets/jibit_kyc_secret_key.txt
# - NOBITEX_TOKEN     -> infra/docker/secrets/nobitex_token.txt
# - S3_ACCESS_KEY    -> infra/docker/secrets/minio_access_key.txt
# - S3_SECRET_KEY    -> infra/docker/secrets/minio_secret_key.txt
# - TOTP_ENCRYPTION_KEY -> infra/docker/secrets/totp_encryption_key.txt
# - ADMIN_MFA_ENCRYPTION_KEY -> infra/docker/secrets/admin_mfa_encryption_key.txt
# - ADMIN_MFA_RECOVERY_PEPPER -> infra/docker/secrets/admin_mfa_recovery_pepper.txt
#   Admin MFA keys must each contain independent 32-byte random values encoded as hex.
# ADMIN_MFA_ISSUER=Tragge Admin
# - GRAFANA_ADMIN_PASSWORD -> infra/docker/secrets/grafana_admin_password.txt
#
# To initialize secrets for development:
#   ./scripts/secrets/init-secrets.sh
#
# To migrate from existing .env:
#   ./scripts/secrets/migrate-from-env.sh
#
# See docs/SECURE_KEY_MANAGEMENT.md for full documentation.
# =============================================================================
