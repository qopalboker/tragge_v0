{{/* Discord alert templates for Tragge Trading Platform */}}

{{/* Default title */}}
{{ define "discord.default.title" -}}
[{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}
{{- end }}

{{/* Default message */}}
{{ define "discord.default.message" -}}
{{ range .Alerts }}
**Alert:** {{ .Labels.alertname }}
**Severity:** {{ .Labels.severity }}
**Service:** {{ if .Labels.service }}{{ .Labels.service }}{{ else }}{{ .Labels.job }}{{ end }}
**Instance:** {{ .Labels.instance }}
**Status:** {{ .Status }}

**Summary:** {{ .Annotations.summary }}

{{ if .Annotations.description -}}
**Description:**
{{ .Annotations.description }}
{{ end -}}

{{ if .Annotations.runbook_url -}}
**Runbook:** {{ .Annotations.runbook_url }}
{{ end -}}

{{ if .Annotations.dashboard_url -}}
**Dashboard:** {{ .Annotations.dashboard_url }}
{{ end -}}
---
{{ end }}
{{- end }}

{{/* Critical alert title */}}
{{ define "discord.critical.title" -}}
:rotating_light: [CRITICAL] {{ .GroupLabels.alertname }}
{{- end }}

{{/* Critical alert message */}}
{{ define "discord.critical.message" -}}
**IMMEDIATE ACTION REQUIRED**

{{ range .Alerts }}
:fire: **Alert:** {{ .Labels.alertname }}
**Severity:** {{ .Labels.severity }}
**Service:** {{ if .Labels.service }}{{ .Labels.service }}{{ else }}{{ .Labels.job }}{{ end }}
**Instance:** {{ .Labels.instance }}
**Status:** {{ .Status }}

**Summary:** {{ .Annotations.summary }}

{{ if .Annotations.description -}}
**Description:**
{{ .Annotations.description }}
{{ end -}}

{{ if .Annotations.runbook_url -}}
:book: **Runbook:** {{ .Annotations.runbook_url }}
{{ end -}}

{{ if .Annotations.dashboard_url -}}
:chart_with_upwards_trend: **Dashboard:** {{ .Annotations.dashboard_url }}
{{ end -}}

**Started:** {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}
{{ if .EndsAt.After .StartsAt -}}
**Ended:** {{ .EndsAt.Format "2006-01-02 15:04:05 UTC" }}
{{ end -}}
---
{{ end }}
{{- end }}

